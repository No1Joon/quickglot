{
  "name": "quickglot",
  "version": "1.0.0",
  "private": true,
  "description": "Safari extension that translates selected text on-device with Apple's Translation framework",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "site": "node scripts/gen-site.mjs"
  },
  "devDependencies": {
    "@types/webextension-polyfill": "^0.12.1",
    "esbuild": "^0.25.0",
    "marked": "^18.0.11",
    "typescript": "^5.7.3"
  }
}
